@model DesignSystem.Documentation.Pages.Components.CatalogModel
@switch (Model.Definition.Slug)
{
    case "icon-button":
        <div class="documentation-catalog-specimen-row">
            <design-system-button variant="@ButtonVariant.Filled" tone="@SemanticTone.Accent" icon-only="true" accessible-label="Add record"><design-system-icon name="@IconName.Plus" decorative="true"></design-system-icon></design-system-button>
            <design-system-button variant="@ButtonVariant.Tonal" tone="@SemanticTone.Neutral" icon-only="true" accessible-label="Search"><design-system-icon name="@IconName.Search" decorative="true"></design-system-icon></design-system-button>
            <design-system-button variant="@ButtonVariant.Text" tone="@SemanticTone.Neutral" icon-only="true" accessible-label="Close"><design-system-icon name="@IconName.Close" decorative="true"></design-system-icon></design-system-button>
        </div>
        break;
    case "button-group":
        <div class="design-system-button-group" data-design-system-align="start" aria-label="Record actions"><design-system-button variant="@ButtonVariant.Text">Cancel</design-system-button><design-system-button variant="@ButtonVariant.Tonal">Save draft</design-system-button><design-system-button variant="@ButtonVariant.Filled" tone="@SemanticTone.Accent">Publish</design-system-button></div>
        break;
    case "toolbar":
        <div class="design-system-toolbar" role="toolbar" aria-label="Record toolbar"><strong class="design-system-toolbar-title">Example record</strong><div class="design-system-toolbar-group"><design-system-button variant="@ButtonVariant.Text" size="@ComponentSize.Small">Edit</design-system-button><span class="design-system-toolbar-separator" aria-hidden="true"></span><design-system-button variant="@ButtonVariant.Text" tone="@SemanticTone.Danger" size="@ComponentSize.Small">Archive</design-system-button></div></div>
        break;
    case "text-field":
        <div class="design-system-field-group"><label class="design-system-field-label" for="catalog-text">Customer name <span class="design-system-field-required">Required</span></label><input class="design-system-field" id="catalog-text" name="customerName" value="Ada Lovelace" required aria-describedby="catalog-text-hint" /><div class="design-system-field-hint" id="catalog-text-hint">Use the customer’s full name.</div></div>
        break;
    case "password-field":
        <div class="design-system-field-group"><label class="design-system-field-label" for="catalog-password">Password</label><input class="design-system-field" id="catalog-password" name="password" type="password" value="example-password" autocomplete="current-password" /><div class="design-system-field-hint">At least 12 characters.</div></div>
        break;
    case "textarea":
        <div class="design-system-field-group"><label class="design-system-field-label" for="catalog-textarea">Notes</label><textarea class="design-system-field design-system-textarea" id="catalog-textarea" rows="4">A concise note that can wrap naturally across multiple lines.</textarea><div class="design-system-field-hint">Up to 500 characters.</div></div>
        break;
    case "search":
        <div><label class="design-system-visually-hidden" for="catalog-search">Search records</label><div class="design-system-search" data-design-system-search><design-system-icon name="@IconName.Search" size="@ComponentSize.Small" decorative="true"></design-system-icon><input id="catalog-search" type="search" value="Example" placeholder="Search records" /><button class="design-system-search-clear" type="button" aria-label="Clear search" data-design-system-search-clear><design-system-icon name="@IconName.Close" size="@ComponentSize.Small" decorative="true"></design-system-icon></button></div></div>
        break;
    case "number-field":
        <div class="design-system-field-group" data-design-system-number><label class="design-system-field-label" for="catalog-number">Quantity</label><div class="design-system-number-control"><input id="catalog-number" name="quantity" type="number" value="3" min="0" max="20" step="1" /><div class="design-system-number-actions"><button class="design-system-number-action" type="button" data-design-system-number-step="down" data-design-system-direction="down" aria-label="Decrease quantity"><design-system-icon name="@IconName.ChevronDown" size="@ComponentSize.Small" decorative="true"></design-system-icon></button><button class="design-system-number-action" type="button" data-design-system-number-step="up" data-design-system-direction="up" aria-label="Increase quantity"><design-system-icon name="@IconName.ChevronDown" size="@ComponentSize.Small" decorative="true"></design-system-icon></button></div></div></div>
        break;
    case "checkbox":
        <div class="documentation-catalog-specimen-stack"><label class="design-system-choice" data-design-system-type="checkbox"><input type="checkbox" name="updates" /><span class="design-system-choice-mark" aria-hidden="true"></span><span>Receive updates</span></label><label class="design-system-choice" data-design-system-type="checkbox"><input type="checkbox" checked /><span class="design-system-choice-mark" aria-hidden="true"></span><span>Selected</span></label><label class="design-system-choice" data-design-system-type="checkbox"><input type="checkbox" disabled /><span class="design-system-choice-mark" aria-hidden="true"></span><span>Disabled</span></label></div>
        break;
    case "radio":
        <fieldset class="documentation-catalog-specimen-stack"><legend class="design-system-field-label">Delivery method</legend><label class="design-system-choice" data-design-system-type="radio"><input type="radio" name="catalog-delivery" checked /><span class="design-system-choice-mark" aria-hidden="true"></span><span>Email</span></label><label class="design-system-choice" data-design-system-type="radio"><input type="radio" name="catalog-delivery" /><span class="design-system-choice-mark" aria-hidden="true"></span><span>Download</span></label><label class="design-system-choice" data-design-system-type="radio"><input type="radio" name="catalog-delivery" disabled /><span class="design-system-choice-mark" aria-hidden="true"></span><span>Postal mail</span></label></fieldset>
        break;
    case "switch":
        <div class="documentation-catalog-specimen-stack"><label class="design-system-switch"><input type="checkbox" role="switch" /><span class="design-system-switch-track"><span class="design-system-switch-thumb"></span></span><span>Compact view</span></label><label class="design-system-switch"><input type="checkbox" role="switch" checked /><span class="design-system-switch-track"><span class="design-system-switch-thumb"></span></span><span>Notifications on</span></label></div>
        break;
    case "picker":
        <form method="get"><design-system-picker model="Model.Picker" /></form>
        break;
    case "date-picker":
        <form method="get"><design-system-date-picker model="Model.DatePicker" /></form>
        break;
    case "file-upload":
        <form method="get"><design-system-file-upload model="Model.FileUpload" /></form>
        break;
    case "link":
        <div class="documentation-catalog-specimen-row"><a class="design-system-link" href="#catalog-live-example-title">Internal link</a><a class="design-system-link" href="https://example.com" target="_blank" rel="noopener noreferrer">External link <design-system-icon name="@IconName.ExternalLink" size="@ComponentSize.Small" decorative="true"></design-system-icon></a><span class="design-system-link" aria-disabled="true">Unavailable</span></div>
        break;
    case "breadcrumb":
        <nav class="design-system-breadcrumbs" aria-label="Breadcrumb"><ol class="design-system-breadcrumb-list"><li><a class="design-system-link" href="#catalog-live-example-title">Components</a></li><li><a class="design-system-link" href="#catalog-live-example-title">Navigation</a></li><li><span aria-current="page">Breadcrumb</span></li></ol></nav>
        break;
    case "pagination":
        <design-system-pagination model="Model.Pagination" />
        break;
    case "navigation-list":
        <nav class="design-system-navigation-tree documentation-catalog-navigation-example" aria-label="Example navigation"><ul class="design-system-navigation-list"><li><details class="design-system-navigation-branch" open data-design-system-current-path><summary class="design-system-navigation-summary" data-design-system-level="top"><design-system-icon class="design-system-navigation-disclosure-icon" name="@IconName.ChevronRight" size="@ComponentSize.Small" decorative="true"></design-system-icon><span>Components</span></summary><ul class="design-system-navigation-list"><li><a class="design-system-navigation-link" data-design-system-depth="1" href="#catalog-live-example-title">Actions</a></li><li><a class="design-system-navigation-link" data-design-system-depth="1" href="#catalog-live-example-title" aria-current="page">Navigation</a></li></ul></details></li></ul></nav>
        break;
    case "tabs":
        <div class="design-system-tabs documentation-catalog-inner-tabs" data-design-system-tabs id="catalog-inner-tabs"><div class="design-system-tab-list" role="tablist" aria-label="Record details"><button class="design-system-tab" id="catalog-tab-overview" type="button" role="tab" aria-selected="true" aria-controls="catalog-panel-overview" data-design-system-tab>Overview</button><button class="design-system-tab" id="catalog-tab-history" type="button" role="tab" aria-selected="false" aria-controls="catalog-panel-history" tabindex="-1" data-design-system-tab>History</button><button class="design-system-tab" id="catalog-tab-disabled" type="button" role="tab" aria-selected="false" aria-controls="catalog-panel-disabled" tabindex="-1" disabled data-design-system-tab>Unavailable</button></div><div class="design-system-tab-panel" id="catalog-panel-overview" role="tabpanel" aria-labelledby="catalog-tab-overview" data-design-system-tab-panel>Overview content is visible.</div><div class="design-system-tab-panel" id="catalog-panel-history" role="tabpanel" aria-labelledby="catalog-tab-history" data-design-system-tab-panel hidden>History content is visible after activation.</div><div class="design-system-tab-panel" id="catalog-panel-disabled" role="tabpanel" aria-labelledby="catalog-tab-disabled" data-design-system-tab-panel hidden>Unavailable content.</div></div>
        break;
    case "segmented":
        <div class="design-system-segmented" role="group" aria-label="View density" data-design-system-segmented><design-system-button variant="@ButtonVariant.Text" size="@ComponentSize.Small" toggle="true" pressed="true" value="list">List</design-system-button><design-system-button variant="@ButtonVariant.Text" size="@ComponentSize.Small" toggle="true" pressed="false" value="grid">Grid</design-system-button><design-system-button variant="@ButtonVariant.Text" size="@ComponentSize.Small" disabled="true">Map</design-system-button></div>
        break;
    case "side-navigation":
        <aside class="design-system-side-navigation documentation-catalog-side-navigation" aria-label="Example side navigation"><div class="design-system-side-navigation-header"><span class="design-system-side-navigation-title">Design System</span></div><div class="design-system-side-navigation-body"><nav class="design-system-navigation-tree" aria-label="Example destinations"><ul class="design-system-navigation-list"><li><a class="design-system-navigation-link" data-design-system-depth="1" href="#catalog-live-example-title">Actions</a></li><li><a class="design-system-navigation-link" data-design-system-depth="1" href="#catalog-live-example-title">Fields</a></li><li><a class="design-system-navigation-link" data-design-system-depth="1" href="#catalog-live-example-title" aria-current="page">Navigation</a></li></ul></nav></div><div class="design-system-side-navigation-footer"><span>Portable shell region</span></div></aside>
        break;
    case "badge":
        <div class="documentation-catalog-specimen-row"><design-system-badge>Draft</design-system-badge><design-system-badge tone="@SemanticTone.Info" appearance="@BadgeAppearance.Solid">Info</design-system-badge><design-system-badge tone="@SemanticTone.Success">Published</design-system-badge><design-system-badge tone="@SemanticTone.Warning" appearance="@BadgeAppearance.Outline">Review</design-system-badge><design-system-badge tone="@SemanticTone.Danger">Blocked</design-system-badge></div>
        break;
    case "status":
        <div class="documentation-catalog-specimen-row"><span class="design-system-status" data-design-system-tone="success"><span class="design-system-status__label">Available</span></span><span class="design-system-status" data-design-system-tone="warning"><span class="design-system-status__label">Needs review</span></span><span class="design-system-status" data-design-system-tone="danger"><span class="design-system-status__label">Unavailable</span></span></div>
        break;
    case "card":
        <article class="design-system-card documentation-catalog-card-example"><div class="design-system-card__media" data-design-system-ratio="wide"><div class="design-system-card__media-placeholder"><design-system-icon name="@IconName.File" size="@ComponentSize.Large" decorative="true"></design-system-icon></div></div><div class="design-system-card__body"><h4 class="design-system-card__title">Example record</h4><p class="design-system-card__description">Neutral content owned by the consuming application.</p><div class="design-system-card__meta"><span>Updated today</span><design-system-badge tone="@SemanticTone.Success">Ready</design-system-badge></div></div><div class="design-system-card__actions"><design-system-button variant="@ButtonVariant.Text" size="@ComponentSize.Small">Open</design-system-button></div></article>
        break;
    case "chip":
        <div class="documentation-catalog-specimen-row"><button class="design-system-chip" type="button" aria-pressed="false">All records</button><button class="design-system-chip" type="button" aria-pressed="true">Active</button><span class="design-system-chip">Customer<button class="design-system-chip-remove" type="button" aria-label="Remove Customer" data-design-system-chip-remove><design-system-icon name="@IconName.Close" size="@ComponentSize.Small" decorative="true"></design-system-icon></button></span></div>
        break;
    case "list":
        <ul class="design-system-list documentation-catalog-list-example"><li><button class="design-system-list__item" type="button" aria-pressed="false"><span class="design-system-list__item-main"><span class="design-system-list__item-title">Example record</span><span class="design-system-list__item-description">Updated today</span></span><span class="design-system-list__item-action"><design-system-icon name="@IconName.ChevronRight" size="@ComponentSize.Small" decorative="true"></design-system-icon></span></button></li><li><button class="design-system-list__item" type="button" aria-pressed="true"><span class="design-system-list__item-main"><span class="design-system-list__item-title">Selected record</span><span class="design-system-list__item-description">Current selection</span></span></button></li><li><button class="design-system-list__item" type="button" disabled aria-disabled="true"><span class="design-system-list__item-main"><span class="design-system-list__item-title">Unavailable record</span></span></button></li></ul>
        break;
    case "table":
        <div class="design-system-table-wrap" role="region" aria-label="Customer records" tabindex="0"><table class="design-system-table" data-design-system-banding="rows"><thead><tr><th scope="col">Customer</th><th scope="col">Status</th><th scope="col" class="design-system-table__number">Records</th></tr></thead><tbody><tr><th scope="row">Ada Lovelace</th><td><span class="design-system-status" data-design-system-tone="success"><span class="design-system-status__label">Active</span></span></td><td class="design-system-table__number">12</td></tr><tr aria-selected="true"><th scope="row">Grace Hopper</th><td><span class="design-system-status" data-design-system-tone="warning"><span class="design-system-status__label">Review</span></span></td><td class="design-system-table__number">8</td></tr></tbody></table></div>
        break;
    case "row":
        <div class="design-system-table-wrap" role="region" aria-label="Row state examples" tabindex="0"><table class="design-system-table"><thead><tr><th scope="col">State</th><th scope="col">Example</th></tr></thead><tbody><tr><th scope="row">Default</th><td>Example record</td></tr><tr data-design-system-preview-state="hover"><th scope="row">Hovered</th><td>Pointer preview</td></tr><tr aria-selected="true"><th scope="row">Selected</th><td>Current selection</td></tr><tr aria-disabled="true"><th scope="row">Disabled</th><td>Unavailable row</td></tr></tbody></table></div>
        break;
    case "column":
        <div class="design-system-table-wrap" role="region" aria-label="Column behavior examples" tabindex="0"><table class="design-system-table"><thead><tr><th scope="col" aria-sort="ascending"><div class="design-system-table__column-header"><button class="design-system-table__sort" type="button">Customer <design-system-icon name="@IconName.ChevronDown" size="@ComponentSize.Small" decorative="true"></design-system-icon></button><input class="design-system-table__filter" type="search" placeholder="Filter" aria-label="Filter Customer" data-design-system-table-filter data-design-system-column="customer" /></div></th><th scope="col">Updated</th></tr></thead><tbody><tr><td>Ada Lovelace</td><td>Today</td></tr><tr><td>Grace Hopper</td><td>Yesterday</td></tr></tbody></table></div>
        break;
    case "alert":
        <div class="documentation-catalog-specimen-stack"><design-system-alert title="Changes saved" tone="@SemanticTone.Success">The record is up to date.</design-system-alert><design-system-alert title="Review required" tone="@SemanticTone.Warning" dismissible="true">Confirm the highlighted values.</design-system-alert><design-system-alert title="Could not save" tone="@SemanticTone.Danger" live-mode="@LiveRegionMode.Assertive">Try again after checking the connection.</design-system-alert></div>
        break;
    case "inline-message":
        <div class="documentation-catalog-specimen-stack"><div class="design-system-inline-message" data-design-system-tone="info"><span class="design-system-inline-message__icon"><design-system-icon name="@IconName.Info" size="@ComponentSize.Small" decorative="true"></design-system-icon></span><span class="design-system-inline-message__content"><strong class="design-system-inline-message__title">Helpful information</strong><span>This value can be changed later.</span></span></div><div class="design-system-inline-message" data-design-system-tone="danger"><span class="design-system-inline-message__icon"><design-system-icon name="@IconName.Warning" size="@ComponentSize.Small" decorative="true"></design-system-icon></span><span class="design-system-inline-message__content"><strong class="design-system-inline-message__title">Invalid value</strong><span>Use a unique reference.</span></span></div></div>
        break;
    case "toast":
        <div class="design-system-toast" data-design-system-tone="success" data-design-system-duration="0" role="status"><span class="design-system-toast__icon"><design-system-icon name="@IconName.Check" size="@ComponentSize.Small" decorative="true"></design-system-icon></span><span class="design-system-toast__content"><strong class="design-system-toast__title">Record saved</strong><span class="design-system-toast__message">Your changes are available.</span></span><button class="design-system-toast__dismiss" type="button" aria-label="Dismiss notification" data-design-system-toast-dismiss><design-system-icon name="@IconName.Close" size="@ComponentSize.Small" decorative="true"></design-system-icon></button></div>
        break;
    case "progress":
        <div class="documentation-catalog-specimen-stack"><div class="design-system-progress" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="64"><div class="design-system-progress__header"><span class="design-system-progress__label">Uploading</span><span class="design-system-progress__value-label">64%</span></div><div class="design-system-progress__track"><div class="design-system-progress__value" style="width:64%"></div></div></div><div class="design-system-progress" data-design-system-indeterminate role="progressbar" aria-label="Loading records" aria-valuetext="Loading"><div class="design-system-progress__header"><span class="design-system-progress__label">Loading records</span></div><div class="design-system-progress__track"><div class="design-system-progress__value"></div></div></div></div>
        break;
    case "spinner":
        <div class="documentation-catalog-specimen-row"><design-system-spinner size="@ComponentSize.Small" accessible-label="Loading small example"></design-system-spinner><design-system-spinner accessible-label="Loading example"></design-system-spinner><design-system-spinner size="@ComponentSize.Large" accessible-label="Loading large example"></design-system-spinner><design-system-spinner decorative="true"></design-system-spinner></div>
        break;
    case "skeleton":
        <div class="documentation-catalog-skeleton-example" aria-label="Loading content" role="status"><span class="design-system-skeleton design-system-skeleton--circle" aria-hidden="true"></span><span class="documentation-catalog-skeleton-lines"><span class="design-system-skeleton" aria-hidden="true"></span><span class="design-system-skeleton" aria-hidden="true"></span></span><span class="design-system-skeleton design-system-skeleton--block" aria-hidden="true"></span></div>
        break;
    case "empty-state":
        <design-system-empty-state model="Model.EmptyState" />
        break;
    case "error-state":
        <section class="design-system-error-state" role="alert"><span class="design-system-error-state__icon"><design-system-icon name="@IconName.Warning" size="@ComponentSize.Large" decorative="true"></design-system-icon></span><div class="design-system-error-state__content"><h4 class="design-system-error-state__title">Could not load records</h4><p class="design-system-error-state__description">Check the connection and try again.</p></div><div class="design-system-error-state__actions"><design-system-button variant="@ButtonVariant.Tonal" tone="@SemanticTone.Danger">Try again</design-system-button></div></section>
        break;
    case "busy-region":
        <div class="design-system-busy-region documentation-catalog-busy-example" aria-busy="true" data-design-system-busy-region><div inert data-design-system-busy-content><strong>Customer records</strong><p>Pending content is temporarily unavailable while status remains announced.</p></div><div class="design-system-busy-state" data-design-system-overlay><design-system-spinner decorative="true"></design-system-spinner><span class="design-system-busy-state__label" role="status">Updating records</span></div></div>
        break;
    case "menu":
        <div class="documentation-catalog-overlay-stage"><div class="design-system-menu-wrap"><design-system-button id="catalog-menu-trigger" aria-expanded="true" data-design-system-menu-trigger>Actions <design-system-icon name="@IconName.ChevronDown" size="@ComponentSize.Small" decorative="true"></design-system-icon></design-system-button><div class="design-system-menu" role="menu" aria-labelledby="catalog-menu-trigger"><div class="design-system-menu-label">Record actions</div><button class="design-system-menu-item" type="button" role="menuitem"><span class="design-system-menu-item-leading"><design-system-icon name="@IconName.File" size="@ComponentSize.Small" decorative="true"></design-system-icon><span class="design-system-menu-item-copy"><span>Open record</span><small class="design-system-menu-item-description">View full details</small></span></span><kbd class="design-system-menu-item-meta">Enter</kbd></button><button class="design-system-menu-item" type="button" role="menuitem" disabled>Duplicate</button><hr class="design-system-menu-separator" /><button class="design-system-menu-item" type="button" role="menuitem" data-design-system-tone="danger">Archive</button></div></div></div>
        break;
    case "context-menu":
        <div class="documentation-catalog-overlay-stage"><design-system-button id="catalog-context-trigger" variant="@ButtonVariant.Text" data-design-system-context-menu="catalog-context-surface">Open context menu</design-system-button><div class="design-system-menu" id="catalog-context-surface" role="menu" aria-labelledby="catalog-context-trigger"><button class="design-system-menu-item" type="button" role="menuitem">Inspect <kbd class="design-system-menu-item-meta">I</kbd></button><button class="design-system-menu-item" type="button" role="menuitem">Duplicate <kbd class="design-system-menu-item-meta">Ctrl+D</kbd></button><button class="design-system-menu-item" type="button" role="menuitem" data-design-system-tone="danger">Archive</button></div></div>
        break;
    case "popover":
        <div class="documentation-catalog-overlay-stage"><div class="design-system-popover-wrap"><design-system-button id="catalog-popover-trigger" data-design-system-popover-trigger="catalog-popover">Record details</design-system-button><section class="design-system-popover" id="catalog-popover" role="dialog" aria-labelledby="catalog-popover-title"><header class="design-system-popover__header" id="catalog-popover-title">Record details</header><div class="design-system-popover__body"><p>Supplemental information remains close to its trigger.</p></div><footer class="design-system-popover__footer"><design-system-button variant="@ButtonVariant.Text" size="@ComponentSize.Small" data-design-system-popover-close>Close</design-system-button></footer></section></div></div>
        break;
    case "tooltip":
        <div class="documentation-catalog-specimen-row"><design-system-button id="catalog-tooltip-trigger" icon-only="true" accessible-label="More information" data-design-system-tooltip-trigger="catalog-tooltip"><design-system-icon name="@IconName.Info" decorative="true"></design-system-icon></design-system-button><div class="design-system-tooltip" id="catalog-tooltip" role="tooltip">More information about this Action.</div></div>
        break;
    case "dialog":
        <div><design-system-button id="catalog-dialog-open" data-design-system-dialog-trigger="catalog-dialog">Open dialog</design-system-button><dialog class="design-system-dialog" id="catalog-dialog" aria-labelledby="catalog-dialog-title" data-design-system-dialog><header class="design-system-dialog__header"><h4 class="design-system-dialog__title" id="catalog-dialog-title">Edit record</h4><design-system-button variant="@ButtonVariant.Text" icon-only="true" accessible-label="Close dialog" data-design-system-dialog-close><design-system-icon name="@IconName.Close" decorative="true"></design-system-icon></design-system-button></header><div class="design-system-dialog__body"><div class="design-system-field-group"><label class="design-system-field-label" for="catalog-dialog-name">Name</label><input class="design-system-field" id="catalog-dialog-name" value="Example record" /></div></div><footer class="design-system-dialog__footer"><design-system-button variant="@ButtonVariant.Text" data-design-system-cancel>Cancel</design-system-button><design-system-button variant="@ButtonVariant.Filled" tone="@SemanticTone.Accent" data-design-system-dialog-close>Save</design-system-button></footer></dialog></div>
        break;
    case "drawer":
        <div><design-system-button id="catalog-drawer-open" data-design-system-drawer-trigger="catalog-drawer">Open drawer</design-system-button><dialog class="design-system-drawer" id="catalog-drawer" aria-labelledby="catalog-drawer-title" data-design-system-drawer data-design-system-side="end"><header class="design-system-drawer__header"><h4 class="design-system-drawer__title" id="catalog-drawer-title">Record details</h4><design-system-button variant="@ButtonVariant.Text" icon-only="true" accessible-label="Close drawer" data-design-system-drawer-close><design-system-icon name="@IconName.Close" decorative="true"></design-system-icon></design-system-button></header><div class="design-system-drawer__body"><p>Secondary content uses the real Drawer Surface.</p></div><footer class="design-system-drawer__footer"><design-system-button variant="@ButtonVariant.Text" data-design-system-drawer-close>Close</design-system-button></footer></dialog></div>
        break;
    case "confirmation-dialog":
        <div><design-system-button id="catalog-confirmation-open" variant="@ButtonVariant.Tonal" tone="@SemanticTone.Danger" data-design-system-confirmation-trigger="catalog-confirmation">Archive record</design-system-button><dialog class="design-system-dialog design-system-dialog--small" id="catalog-confirmation" aria-labelledby="catalog-confirmation-title" data-design-system-confirmation-dialog><header class="design-system-dialog__header"><h4 class="design-system-dialog__title" id="catalog-confirmation-title">Archive record?</h4></header><div class="design-system-dialog__body"><p>The record will leave active results. This Action can be reversed later.</p></div><footer class="design-system-dialog__footer"><design-system-button variant="@ButtonVariant.Text" data-design-system-cancel>Cancel</design-system-button><design-system-button variant="@ButtonVariant.Tonal" tone="@SemanticTone.Danger" data-design-system-confirm data-design-system-value="archive">Archive</design-system-button></footer></dialog></div>
        break;
}
