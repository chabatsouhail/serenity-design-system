                        <li data-documentation-reference-toc-group>
                            <a class="design-system-tab documentation-reference-toc-parent" href="#primitive-typography-tokens-title" aria-current="location">Primitive Tokens</a>
                            <ol class="documentation-reference-toc-sublist">
                                @for (var groupIndex = 0; groupIndex < primitiveTokenGroups.Length; groupIndex++)
                                {
                                    <li><a class="design-system-tab documentation-reference-toc-child" href="#primitive-typography-group-@groupIndex-title">@primitiveTokenGroups[groupIndex].Name</a></li>
                                }
                            </ol>
                        </li>
                        <li data-documentation-reference-toc-group>
                            <a class="design-system-tab documentation-reference-toc-parent" href="#semantic-typography-tokens-title">Semantic Tokens</a>
                            <ol class="documentation-reference-toc-sublist">
                                <li><a class="design-system-tab documentation-reference-toc-child" href="#semantic-typography-reading-title">Reading Type Styles</a></li>
                                <li><a class="design-system-tab documentation-reference-toc-child" href="#semantic-typography-interface-title">Interface Type Styles</a></li>
                            </ol>
                        </li>
                    </ol>
                </nav>

                <div class="documentation-token-category-list">
                    <section class="documentation-token-category" id="primitive-typography-tokens" aria-labelledby="primitive-typography-tokens-title">
                        <div class="documentation-token-category-heading">
                            <h3 id="primitive-typography-tokens-title">Primitive Tokens</h3>
                            <p>Individual Typeface, Size, Line Height, Weight, and decoration Values.</p>
                        </div>
                <div class="documentation-token-panel-content">
                    @for (var groupIndex = 0; groupIndex < primitiveTokenGroups.Length; groupIndex++)
                    {
                        var group = primitiveTokenGroups[groupIndex];
                        var groupTitleId = $"primitive-typography-group-{groupIndex}-title";
                        <section class="documentation-subsection" aria-labelledby="@groupTitleId">
                            <div class="documentation-subsection-heading">
                                <h4 id="@groupTitleId">@group.Name</h4>
                                <p>@group.Purpose</p>
                            </div>
                            <div class="design-system-table-wrap documentation-typography-token-wrap" role="region" aria-label="@group.Name Primitive Typography Tokens" tabindex="0">
                                <table class="design-system-table documentation-typography-token-table documentation-primitive-token-table documentation-three-column-primitive-token-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Value</th>
                                            <th scope="col">Preview</th>
                                            <th scope="col">Primitive Token</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var token in group.Tokens)
                                        {
                                            <tr>
                                                <th scope="row"><code>@token.Value</code></th>
                                                <td>
                                                    <span class="documentation-typography-primitive-preview" data-documentation-typography-preview="@TokenName(token.Token)" aria-label="@token.Value Preview">
                                                        <span>Aa</span>
                                                        <span aria-hidden="true">Aa</span>
                                                    </span>
                                                </td>
                                                <td><code class="documentation-token-name">@TokenName(token.Token)</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                </div>
                    </section>

                    <section class="documentation-token-category" id="semantic-typography-tokens" aria-labelledby="semantic-typography-tokens-title">
                        <div class="documentation-token-category-heading">
                            <h3 id="semantic-typography-tokens-title">Semantic Tokens</h3>
                            <p>Complete Type Styles used directly by Foundations and Components.</p>
                        </div>
                <div class="documentation-token-panel-content">
                    <section class="documentation-subsection" aria-labelledby="semantic-typography-reading-title">
                        <div class="documentation-subsection-heading">
                            <h4 id="semantic-typography-reading-title">Reading Type Styles</h4>
                            <p>Headings, reading text, metadata, and technical content.</p>
                        </div>
                        <div class="design-system-table-wrap documentation-typography-token-wrap" role="region" aria-label="Reading Type Style Tokens" tabindex="0">
                            <table class="design-system-table documentation-typography-token-table documentation-typography-semantic-table">
                                <thead><tr><th scope="col">Role</th><th scope="col">Primitive Composition</th><th scope="col">Semantic Token</th></tr></thead>
                                <tbody>
                                    @foreach (var style in readingTypeStyles)
                                    {
                                        <tr>
                                            <th scope="row"><span class="documentation-table-label"><span>@style.Name</span><small>@style.Purpose</small></span></th>
                                            <td><span class="documentation-token-source-list">@foreach (var source in style.Sources.Split(" + ", StringSplitOptions.RemoveEmptyEntries)) { <code class="documentation-token-name">design-system-primitive-typography-@source</code> }</span></td>
                                            <td><code class="documentation-token-name">@TokenName(style.Token)</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="documentation-subsection" aria-labelledby="semantic-typography-interface-title">
                        <div class="documentation-subsection-heading">
                            <h4 id="semantic-typography-interface-title">Interface Type Styles</h4>
                            <p>Labels, Controls, and Actions that prioritize compact clarity.</p>
                        </div>
                        <div class="design-system-table-wrap documentation-typography-token-wrap" role="region" aria-label="Interface Type Style Tokens" tabindex="0">
                            <table class="design-system-table documentation-typography-token-table documentation-typography-semantic-table">
                                <thead><tr><th scope="col">Role</th><th scope="col">Primitive Composition</th><th scope="col">Semantic Token</th></tr></thead>
                                <tbody>
                                    @foreach (var style in interfaceTypeStyles)
                                    {
                                        <tr>
                                            <th scope="row"><span class="documentation-table-label"><span>@style.Name</span><small>@style.Purpose</small></span></th>
                                            <td><span class="documentation-token-source-list">@foreach (var source in style.Sources.Split(" + ", StringSplitOptions.RemoveEmptyEntries)) { <code class="documentation-token-name">design-system-primitive-typography-@source</code> }</span></td>
                                            <td><code class="documentation-token-name">@TokenName(style.Token)</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>

                </div>
                    </section>
                </div>
            </section>
        </div>
    </div>

</article>
