@page "/foundations/typography"
@{
    ViewData["Title"] = "Typography";

    var primitiveTokenGroups = new[]
    {
        (Name: "Font Family", Purpose: "Typefaces available for interface and technical text.", Tokens: new[]
        {
            (Value: "IBM Plex Sans", Token: "--design-system-primitive-typography-family-ibm-plex-sans"),
            (Value: "IBM Plex Serif", Token: "--design-system-primitive-typography-family-ibm-plex-serif"),
            (Value: "IBM Plex Mono", Token: "--design-system-primitive-typography-family-ibm-plex-mono")
        }),
        (Name: "Font Style", Purpose: "Regular and Italic forms available across the shipped Typefaces.", Tokens: new[]
        {
            (Value: "Regular", Token: "--design-system-primitive-typography-style-normal"),
            (Value: "Italic", Token: "--design-system-primitive-typography-style-italic")
        }),
        (Name: "Font Size", Purpose: "Approved sizes that establish hierarchy and reading priority.", Tokens: new[]
        {
            (Value: "11px", Token: "--design-system-primitive-typography-size-11"),
            (Value: "12px", Token: "--design-system-primitive-typography-size-12"),
            (Value: "13px", Token: "--design-system-primitive-typography-size-13"),
            (Value: "14px", Token: "--design-system-primitive-typography-size-14"),
            (Value: "16px", Token: "--design-system-primitive-typography-size-16"),
            (Value: "20px", Token: "--design-system-primitive-typography-size-20"),
            (Value: "28px", Token: "--design-system-primitive-typography-size-28")
        }),
        (Name: "Font Weight", Purpose: "Exact shipped strengths from Regular through Bold.", Tokens: new[]
        {
            (Value: "400", Token: "--design-system-primitive-typography-weight-400"),
            (Value: "500", Token: "--design-system-primitive-typography-weight-500"),
            (Value: "600", Token: "--design-system-primitive-typography-weight-600"),
            (Value: "700", Token: "--design-system-primitive-typography-weight-700")
        }),
        (Name: "Line Height", Purpose: "Vertical rhythm for single-line and multi-line text.", Tokens: new[]
        {
            (Value: "1", Token: "--design-system-primitive-typography-line-height-1"),
            (Value: "1.25", Token: "--design-system-primitive-typography-line-height-1-25"),
            (Value: "1.5", Token: "--design-system-primitive-typography-line-height-1-5")
        }),
        (Name: "Underline", Purpose: "Reusable decoration placement for Links and text.", Tokens: new[]
        {
            (Value: ".2em", Token: "--design-system-primitive-typography-underline-offset-0-2em")
        })
    };

    var readingTypeStyles = new[]
    {
        (Name: "Heading 1", Purpose: "Primary Page title", Composition: "Regular · 500 · 28px / 1.25 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-28 + line-height-1-25 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-heading-1"),
        (Name: "Heading 2", Purpose: "Section title", Composition: "Regular · 500 · 20px / 1.25 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-20 + line-height-1-25 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-heading-2"),
        (Name: "Heading 3", Purpose: "Subsection title", Composition: "Regular · 500 · 16px / 1.25 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-16 + line-height-1-25 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-heading-3"),
        (Name: "Heading 4", Purpose: "Group title", Composition: "Regular · 500 · 14px / 1.25 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-14 + line-height-1-25 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-heading-4"),
        (Name: "Body Small", Purpose: "Compact reading text", Composition: "Regular · 400 · 12px / 1.5 · IBM Plex Sans", Sources: "style-normal + weight-400 + size-12 + line-height-1-5 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-body-small"),
        (Name: "Body", Purpose: "Default reading text", Composition: "Regular · 400 · 13px / 1.5 · IBM Plex Sans", Sources: "style-normal + weight-400 + size-13 + line-height-1-5 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-body"),
        (Name: "Body Large", Purpose: "Prominent reading text", Composition: "Regular · 400 · 14px / 1.5 · IBM Plex Sans", Sources: "style-normal + weight-400 + size-14 + line-height-1-5 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-body-large"),
        (Name: "Caption", Purpose: "Supporting metadata", Composition: "Regular · 400 · 11px / 1.5 · IBM Plex Sans", Sources: "style-normal + weight-400 + size-11 + line-height-1-5 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-caption"),
        (Name: "Code", Purpose: "Code, identifiers, and Token names", Composition: "Regular · 400 · 12px / 1.5 · IBM Plex Mono", Sources: "style-normal + weight-400 + size-12 + line-height-1-5 + family-ibm-plex-mono", Token: "--design-system-semantic-typography-code")
    };

    var interfaceTypeStyles = new[]
    {
        (Name: "Label", Purpose: "Control and data labels", Composition: "Regular · 500 · 12px / 1.5 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-12 + line-height-1-5 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-label"),
        (Name: "Label Compact", Purpose: "Single-line compact labels", Composition: "Regular · 500 · 12px / 1 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-12 + line-height-1 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-label-compact"),
        (Name: "Caption Compact", Purpose: "Single-line compact metadata", Composition: "Regular · 500 · 11px / 1 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-11 + line-height-1 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-caption-compact"),
        (Name: "Control", Purpose: "Text entered inside controls", Composition: "Regular · 400 · 13px / 1 · IBM Plex Sans", Sources: "style-normal + weight-400 + size-13 + line-height-1 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-control"),
        (Name: "Action Small", Purpose: "Compact action labels", Composition: "Regular · 500 · 12px / 1 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-12 + line-height-1 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-action-small"),
        (Name: "Action", Purpose: "Default action labels", Composition: "Regular · 500 · 13px / 1 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-13 + line-height-1 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-action"),
        (Name: "Action Large", Purpose: "Large action labels", Composition: "Regular · 500 · 14px / 1 · IBM Plex Sans", Sources: "style-normal + weight-500 + size-14 + line-height-1 + family-ibm-plex-sans", Token: "--design-system-semantic-typography-action-large")
    };

    string TokenName(string token) => token.StartsWith("--", StringComparison.Ordinal) ? token[2..] : token;
}

